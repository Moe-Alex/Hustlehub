# nginx settings for the HustleHub+ web container. ${API_UPSTREAM} is filled in when the container starts.
# The security headers match the ones set by vite.config.js for "npm start", so Docker and local runs behave the same.

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /tmp/certs/cert.pem;
    ssl_certificate_key /tmp/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # The browser only ever talks to this server; API calls are forwarded to the API container.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_verify off;  # the API uses a self-signed certificate inside the private Docker network
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have hashed names, so they can be cached for a long time.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # React handles page routes in the browser: unknown paths fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
