# Server
PORT=5000
NODE_ENV=development

# JWT: Generate a random string by running this command in a terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_secret_value
JWT_EXPIRES_IN=1h

# HTTPS (self-signed cert paths - see README on how to generate them)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
