# Server
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Create a database user and allow your IP address under Network Access.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/hustlehub?retryWrites=true&w=majority

# JWT: must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_value
JWT_EXPIRES_IN=1h

# Frontend origins allowed to call this API (comma separated)
CLIENT_ORIGIN=https://localhost:5173,http://localhost:5173

# Used only by "npm run seed:admin" - admins cannot self-register through the API
ADMIN_USERNAME=hustlehub_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# HTTPS (self-signed cert paths - see README on how to generate them)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Account lockout (extra security feature): this many wrong passwords for one email locks logins for that email.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Logging. Events always go to the console and to logs/events.log (set LOG_TO_FILE=false in containers).
LOG_LEVEL=info
LOG_TO_FILE=true
# LOG_FORMAT=json prints JSON lines instead of readable text (the default in production).
# LOG_FORMAT=json
# LOG_ENVIRONMENT is the "env" label on cloud log lines, e.g. local, ci, production.
# LOG_ENVIRONMENT=local

# Cloud logging with Grafana Cloud Loki (optional - leave these empty to log locally only).
# Grafana Cloud > your stack > Loki > Details gives the URL and User; the token comes from an
# access policy with the logs:write scope. NEVER commit real values - keep them in .env or repository secrets.
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=

# Number of reverse proxies in front of the API (1 when running behind the nginx container in Docker Compose, otherwise 0).
TRUST_PROXY_HOPS=0
