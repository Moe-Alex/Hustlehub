{
  "info": {
    "name": "HustleHub+ API (Part 2)",
    "description": "Automated API tests for HustleHub+: authentication, gigs, bookings, transactions, RBAC, validation, sanitisation, security headers and rate limiting. Run with `npm test` (Newman) or import into Postman and run the collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Setup and security headers",
      "description": "Starts a fresh run and checks the API is reachable over HTTPS with security headers.",
      "item": [
        {
          "name": "Health check (starts a new run)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('API reports it is running', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Security headers are present",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = (n) => pm.response.headers.get(n);",
                  "pm.test('Content-Security-Policy blocks everything by default', () => pm.expect(h('Content-Security-Policy')).to.include(\"default-src 'none'\"));",
                  "pm.test('CSP forbids framing', () => pm.expect(h('Content-Security-Policy')).to.include(\"frame-ancestors 'none'\"));",
                  "pm.test('X-Content-Type-Options is nosniff', () => pm.expect(h('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('X-Frame-Options is DENY', () => pm.expect(h('X-Frame-Options')).to.eql('DENY'));",
                  "pm.test('Referrer-Policy is no-referrer', () => pm.expect(h('Referrer-Policy')).to.eql('no-referrer'));",
                  "pm.test('Responses are not cacheable', () => pm.expect(h('Cache-Control')).to.eql('no-store'));",
                  "pm.test('X-Powered-By is not exposed', () => pm.expect(h('X-Powered-By')).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    }
  ]
}
