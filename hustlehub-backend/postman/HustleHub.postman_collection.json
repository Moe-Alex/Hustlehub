        {
          "name": "JWT payload holds id and role but no password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response success flag is true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const part = pm.collectionVariables.get('claToken').split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const payload = JSON.parse(atob(part));",
                  "pm.test('Payload has id and role', () => { pm.expect(payload).to.have.property('id'); pm.expect(payload.role).to.eql('client'); });",
                  "pm.test('Payload has an expiry', () => pm.expect(payload).to.have.property('exp'));",
                  "pm.test('Payload contains no password', () => pm.expect(JSON.stringify(payload)).to.not.include('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{claToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/profile"
          }
        },
