{
  "name": "hustlehub-backend",
  "version": "1.0.0",
  "description": "HustleHub+ - secure freelancer marketplace API (Node.js, Express, MongoDB, JWT, RBAC, tax estimation, structured logging)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "migrate:bookings": "node scripts/migrateBookingStatuses.js",
    "test": "node scripts/run-newman.js",
    "test:api": "node scripts/run-newman.js",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:all": "npm run test:unit && npm run test:api",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "c8 node --test \"tests/**/*.test.js\" && c8 --clean=false node scripts/run-newman.js"
  },
  "keywords": [
    "hustlehub",
    "express",
    "jwt",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.0",
    "xss": "^1.0.15"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0"
  }
}
