<mxfile host="app.diagrams.net" agent="HustleHub+" version="24.0.0"><diagram id="hustlehub-part2" name="HustleHub+ Part 2 Architecture"><mxGraphModel dx="1260" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_client" value="Client Boundary (untrusted)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0057b8;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontStyle=0;fontSize=12;fontColor=#0057b8;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="720" height="130" as="geometry"/></mxCell><mxCell id="b_vite" value="Vite server (frontend)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=12 12;verticalAlign=top;align=right;spacingLeft=20;spacingRight=20;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="560" height="125" as="geometry"/></mxCell><mxCell id="b_api" value="Node.js + Express REST API - Server Trust Boundary (HTTPS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=12 12;verticalAlign=top;align=left;spacingLeft=20;spacingRight=20;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="1140" height="930" as="geometry"/></mxCell><mxCell id="b_db" value="Database Trust Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=12 12;verticalAlign=top;align=left;spacingLeft=20;spacingRight=20;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="1400" width="420" height="190" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Browser: React app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Vite + React 19, React Router&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;role-aware menu (convenience only)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#0057b8;fontColor=#0057b8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="65" width="300" height="70" as="geometry"/></mxCell><mxCell id="postman" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Postman + Newman&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;114 requests, 300 assertions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;runs against a test database&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#0057b8;fontColor=#0057b8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="65" width="300" height="70" as="geometry"/></mxCell><mxCell id="static" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Static files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;strict CSP, nosniff,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;no framing, no inline scripts&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="255" width="200" height="70" as="geometry"/></mxCell><mxCell id="proxy" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Proxy for /api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;forwards to the API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;over HTTPS&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="255" width="200" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Helmet + CSP + CORS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;security headers on every response&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;CORS origin allow-list&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="430" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Body limit 10 KB + Sanitiser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;strips $ and . keys (NoSQL injection)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;strips HTML (scripting attacks)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="530" width="300" height="70" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;General rate limiter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;300 requests / 15 min / IP&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="630" width="300" height="60" as="geometry"/></mxCell><mxCell id="router" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Express Router&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;/auth /gigs /bookings&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;/transactions /admin&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b35900;fontColor=#b35900;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="340" height="130" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Route limiters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;login: 10 failed / 15 min&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;register: 20 / hour&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="280" height="70" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Input validation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;express-validator, strong password rules&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="995" width="280" height="60" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Auth controller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;constant-time login, no user hints&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;signs JWT (HS256, 1 hour)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="1095" width="280" height="80" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;bcrypt + jsonwebtoken&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;hash (12 rounds) / compare, sign JWT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#b3b300;fontColor=#808000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="1215" width="280" height="60" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;protect (JWT check)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;signature, pinned algorithm, expiry;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;reloads the user from the database&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="880" width="300" height="70" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;requireRole&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;client / freelancer / admin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;ownership checked in the controller&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="990" width="300" height="70" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Route limiters + validation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;bookings: 5 / 10 min per user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;gig writes: 30 / 15 min per user&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;express-validator on every field&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1100" width="300" height="80" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Controllers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;gigs, bookings, transactions, admin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;price taken from the database,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;a transaction for every booking&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ccffe0;strokeColor=#00a050;fontColor=#007a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1220" width="300" height="80" as="geometry"/></mxCell><mxCell id="err" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Central Error Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;errorMiddleware.js&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;client gets a short safe message only&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#b30000;fontColor=#b30000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="990" width="300" height="70" as="geometry"/></mxCell><mxCell id="log" value="&lt;b style=&quot;font-size:13px;&quot;&gt;logger.js (server-side only)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;full details, never sent to the client&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5ccff;strokeColor=#5900b3;fontColor=#5900b3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="1100" width="300" height="60" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:13px;&quot;&gt;MongoDB Atlas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;TLS, encrypted at rest&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;users, gigs, bookings, transactions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Mongoose models&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#ccf2f4;strokeColor=#0e7c86;fontColor=#0e5560;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="1450" width="320" height="110" as="geometry"/></mxCell><mxCell id="note" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Part 1 file storage replaced&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;data/users.json  -&amp;gt;  MongoDB Atlas + Mongoose&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="1380" width="330" height="60" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=classic;endFill=1;strokeColor=#000000;exitX=0;exi