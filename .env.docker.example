# Settings for "docker compose up". Copy this file to .env (same folder as docker-compose.yml) and fill it in.
# .env is ignored by git - NEVER commit it, and never paste real values into this example file.

# Password for the MongoDB container. Use letters and digits only (it is placed inside a connection string).
MONGO_ROOT_PASSWORD=

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only by:  docker compose run --rm api npm run seed:admin   (admins cannot register through the app)
ADMIN_USERNAME=hustlehub_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: where the web app is published, and cloud logging with Grafana Cloud Loki.
# WEB_PORT=8443
# LOKI_URL=
# LOKI_USER=
# LOKI_TOKEN=
